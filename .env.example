# ==============================================================================
# CONFIGURAÇÃO DA PLATAFORMA — CONTROLE FINANCEIRO & OPEN FINANCE (CARTÃO BRUNO)
# Copie este arquivo para .env na raiz do projeto e preencha apenas valores reais
# no seu ambiente local/servidor. JAMAIS versione o arquivo .env real.
# ==============================================================================

# 1. CREDENCIAIS PLUGGY OPEN FINANCE (Estritamente Backend)
# Suporta tanto a nomenclatura padrão quanto ClientIDpluggy / ClientSecretpluggy
PLUGGY_CLIENT_ID=seu_client_id_pluggy_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy_aqui

# 2. BANCO DE DADOS E FUSO HORÁRIO
DATABASE_URL=sqlite:///./finance_control.db
APP_TIMEZONE=America/Sao_Paulo
APP_FRONTEND_URL=http://localhost:5173

# 3. CANAL PRIORITÁRIO DE RELATÓRIOS: E-MAIL (Resend API ou SMTP TLS)
# Opção A: Resend API (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Financeiro <relatorios@seudominio.com.br>

# Opção B: Servidor SMTP Padrão (Gmail App Password, AWS SES, Zoho, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_aqui

# 4. CANAIS SECUNDÁRIOS OPCIONAIS (Telegram Bot / Discord Webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
